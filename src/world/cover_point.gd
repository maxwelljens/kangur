class_name CoverPoint
extends Marker2D
## A spot a character can fight from: lean out, crouch behind, peek over.
## Generated by `tools/build_map.gd` from block edges; designers may move,
## retune or add points in the editor. Read by AI cover selection + squad logic.

## Direction from the cover face into the open lane (world space, unit-ish).
@export var lean_dir: Vector2 = Vector2.RIGHT
## 0..1. Higher = better cover: low cover on the line, no exposure to the lane.
@export var quality: float = 0.5
## Lane names this point covers (see BlockoutDef.lanes / maps.md lane graph).
@export var lanes: Array[StringName] = []

## Where a character stands to use this point: one body-step back from the
## cover face, i.e. opposite the lean direction.
const STAND_BACK := 12.0

func stand_position() -> Vector2:
	return global_position - lean_dir.normalized() * STAND_BACK