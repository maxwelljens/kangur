; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Kangur"
config/description="Singleplayer topdown tactical shooter. Corporate mercenaries. Europe, 2041."
config/version="0.1.0"
run/main_scene="res://src/core/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/icons/kangur_icon.svg"

[audio]

buses/default_bus_layout="res://assets/audio/default_bus_layout.tres"

[autoload]

EventBus="*res://src/core/event_bus.gd"
Defs="*res://src/core/defs.gd"
Settings="*res://src/core/settings.gd"
AudioDirector="*res://src/audio/audio_director.gd"
Game="*res://src/core/game.gd"
Dev="*res://src/core/dev.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-vision-cone/plugin.cfg", "res://addons/gdUnit4/plugin.cfg", "res://addons/at-icons/plugin.cfg")

[physics]

2d/default_gravity=0.0
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.043, 0.055, 0.078, 1)
